# ─── Data Source ───────────────────────────────────────────────────────────────
# true  → static mock data stored in localStorage (no backend required)
# false → real REST API requests via axios
VITE_USE_MOCK=true

# ─── REST API (active only when VITE_USE_MOCK=false) ───────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── Mock response delay (ms) ──────────────────────────────────────────────────
VITE_MOCK_DELAY_MS=600

# ─── EmailJS — password-reset code delivery ────────────────────────────────────
# Leave blank to display the code on-screen (development fallback).
# Get your keys at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
